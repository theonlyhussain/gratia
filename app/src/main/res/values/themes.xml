<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Gratia" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/gr_base_dark</item>
    </style>

    <style name="Theme.Gratia.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/logo_red_bg</item>
        <!-- The system splash drew the stock template foreground (the Android
             robot) because ic_launcher_foreground.xml is the unmodified AML
             starter asset. The launcher icon mipmap is Gratia's own art, and
             the SplashScreen API accepts any drawable: point the window at
             the real logo so cold start shows Gratia, not Android. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/logo_red_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Gratia</item>
    </style>
</resources>
